# Safe local-development variable names and placeholders only. No real credentials belong here.
NODE_ENV=development
AUTH_MODE=development
PUBLIC_ORIGIN=https://preview.codeline.work
# Bun/Hono API listens on the API host port; Vite uses UI_PORT for the UI host port.
HOST=0.0.0.0
PORT=6001
UI_PORT=6000
DATABASE_URL=postgres://codeline:replace-with-local-password@127.0.0.1:6002/codeline
DEVELOPMENT_IDENTITY_KEY=local-development
DEVELOPMENT_IDENTITY_DISPLAY_NAME=Local Development
DEVELOPMENT_IDENTITY_EMAIL=local-development@example.test
# Optional local checkout used by the repository-managed git-store link script.
# GIT_STORE_CHECKOUT=../git-store-clean-779c05b
# The managed UI is reached through PUBLIC_ORIGIN. Zero appends
# /sync/v<protocol>/connect to the cache origin; Vite proxies that WebSocket
# path to the managed cache on localhost:6003.
# Production builds unset the VITE_ZERO_* variables and use same-origin fallbacks.
# These five URLs must stay derived from PUBLIC_ORIGIN. Do not use 127.0.0.1 here.
VITE_ZERO_CACHE_URL=https://preview.codeline.work
VITE_ZERO_QUERY_URL=https://preview.codeline.work/api/query
VITE_ZERO_MUTATE_URL=https://preview.codeline.work/api/mutate
ZERO_CACHE_URL=http://127.0.0.1:6003
# Cache allowlist must equal the browser query/mutate URLs. Compose maps
# preview.codeline.work to the host gateway so the container can reach the API.
ZERO_QUERY_URL=https://preview.codeline.work/api/query
ZERO_MUTATE_URL=https://preview.codeline.work/api/mutate
ZERO_QUERY_FORWARD_COOKIES=true
ZERO_MUTATE_FORWARD_COOKIES=true
ZERO_AUTH_REVALIDATE_INTERVAL_SECONDS=300
SESSION_SECRET=replace-with-a-local-secret
CONFIG_STORE_DIR=./data/config
# Optional JSON array of filesystem roots whose immediate child directories are discoverable projects.
# Omit this variable to use the operating-system home directory; set it to [] to disable project discovery.
# Relative paths are resolved from the Codeline process working directory and duplicate roots are removed.
# CODELINE_PROJECT_ROOTS=["./projects","../shared-projects"]
# Reserved for durable stream handling; the current test SSE timeout is query-controlled.
STREAM_INACTIVITY_TIMEOUT_SECONDS=120

# OIDC mode is provider-neutral. Required when AUTH_MODE=oidc.
# OIDC_ISSUER=https://issuer.example.test
# OIDC_CLIENT_ID=replace-with-oidc-client-id
# OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
# OIDC_REDIRECT_URI=https://codeline.example.test/api/auth/callback
# Zitadel deployments may use these aliases instead of the OIDC_* names. Do not set conflicting duplicates.
# ZITADEL_ISSUER=https://issuer.example.test
# ZITADEL_CLIENT_ID=replace-with-oidc-client-id
# ZITADEL_CLIENT_SECRET=replace-with-oidc-client-secret
# ZITADEL_REDIRECT_URI=https://codeline.example.test/login/zitadel/callback

# Podman local services. Replace password values in ignored .env before use.
ZERO_CHECKOUT=/home/david/opensource/zero
POSTGRES_DB=codeline
POSTGRES_PASSWORD=replace-with-local-password
# Host ports are distinct from the fixed service ports inside the containers.
POSTGRES_PORT=6002
POSTGRES_USER=codeline
ZERO_ADMIN_PASSWORD=replace-with-local-admin-password
ZERO_APP_ID=codeline
ZERO_CHANGE_DB=postgres://codeline:replace-with-local-password@postgres:5432/codeline
ZERO_CVR_DB=postgres://codeline:replace-with-local-password@postgres:5432/codeline
ZERO_PORT=6003
ZERO_REPLICA_FILE=/var/lib/zero/zero.db
ZERO_UPSTREAM_DB=postgres://codeline:replace-with-local-password@postgres:5432/codeline

# Provider credentials for the seeded catalog agents. Keep literal values only in the ignored project .env.
# CODEX_LB_API_TOKEN=
# CLIPROXYAPI_API_KEY=
# SUBS_CONTENTOREN_DE_API_KEY=
