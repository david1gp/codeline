# Safe local-development configuration only. No provider or deployment credentials belong here.
NODE_ENV=development
# Bun/Hono API listens here; the Vite development UI uses port 5173.
HOST=127.0.0.1
PORT=3004
DATABASE_URL=postgres://codeline:codeline@127.0.0.1:5432/codeline
ZERO_CACHE_URL=http://127.0.0.1:4848
SESSION_SECRET=replace-with-a-local-secret
CONFIG_STORE_DIR=./data/config
# Reserved for durable stream handling; the current test SSE timeout is query-controlled.
STREAM_INACTIVITY_TIMEOUT_SECONDS=120

# Provider credentials are intentionally omitted. Configure local adapters outside this file when implemented.
