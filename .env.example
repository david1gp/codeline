# Safe local-development variable names and placeholders only. No real credentials belong here.
NODE_ENV=development
AUTH_MODE=development
PUBLIC_ORIGIN=https://preview.codeline.work
# The managed combined Bun service listens on PORT; UI_PORT is only for local Vite development.
HOST=0.0.0.0
PORT=6001
UI_PORT=6000
# SQLite database used by database tooling. The managed API resolves the same
# repository-local file directly as data/db.sqlite.
DATABASE_URL=file:./data/db.sqlite
DEVELOPMENT_IDENTITY_KEY=local-development
DEVELOPMENT_IDENTITY_DISPLAY_NAME=Local Development
DEVELOPMENT_IDENTITY_EMAIL=local-development@example.test
# Optional local checkout used by the repository-managed git-store link script.
# GIT_STORE_CHECKOUT=../git-store-clean-779c05b
# Vite exposes this server setting to the sidebar; do not configure a separate VITE_* page size.
SESSIONS_SIDEBAR_PAGE_SIZE=25
SESSION_SECRET=replace-with-a-local-secret
CONFIG_STORE_DIR=./data/config
# Optional JSON array of filesystem roots whose immediate child directories are discoverable projects.
# Omit this variable to use the operating-system home directory; set it to [] to disable project discovery.
# Relative paths are resolved from the Codeline process working directory and duplicate roots are removed.
# CODELINE_PROJECT_ROOTS=["./projects","../shared-projects"]
# OIDC mode supports one provider or both providers concurrently. Every configured provider requires an issuer,
# client ID, and its provider-side resource-owner organization ID. Each client must register this exact shared callback:
# https://preview.codeline.work/api/auth/callback
#
# Explicit concurrent Authworks and Zitadel namespaces:
# OIDC_AUTHWORKS_ISSUER=https://authworks.example.test
# OIDC_AUTHWORKS_CLIENT_ID=replace-with-authworks-client-id
# OIDC_AUTHWORKS_CLIENT_SECRET=replace-with-authworks-client-secret
# OIDC_AUTHWORKS_ORGANIZATION_ID=replace-with-authworks-resource-owner-id
# OIDC_AUTHWORKS_REDIRECT_URI=https://preview.codeline.work/api/auth/callback
# OIDC_ZITADEL_ISSUER=https://zitadel.example.test
# OIDC_ZITADEL_CLIENT_ID=replace-with-zitadel-client-id
# OIDC_ZITADEL_CLIENT_SECRET=replace-with-zitadel-client-secret
# OIDC_ZITADEL_ORGANIZATION_ID=replace-with-zitadel-resource-owner-id
# OIDC_ZITADEL_REDIRECT_URI=https://preview.codeline.work/api/auth/callback
# The explicit provider organization values may differ. The shared local Codeline organization external ID is
# configured separately with OIDC_ORGANIZATION_ID below; each provider claim must equal its own provider ID.
#
# Legacy single-provider compatibility is retained. Use either the provider-neutral OIDC_* names or the
# existing Zitadel aliases below; do not set conflicting aliases. Omit provider from the login query when
# exactly one provider is configured. With both providers configured, login requires provider=authworks or
# provider=zitadel. The callback always uses the issuer stored in the OIDC transaction, not callback query input.
# OIDC_ISSUER=https://issuer.example.test
# OIDC_CLIENT_ID=replace-with-oidc-client-id
# OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
# OIDC_REDIRECT_URI=https://preview.codeline.work/api/auth/callback
# ZITADEL_ISSUER=https://issuer.example.test
# ZITADEL_CLIENT_ID=replace-with-oidc-client-id
# ZITADEL_CLIENT_SECRET=replace-with-oidc-client-secret
# ZITADEL_REDIRECT_URI=https://preview.codeline.work/api/auth/callback
# Required by db:seed, db:reset-seed, and AUTH_MODE=oidc. Set this non-secret value to the local Codeline
# organization external ID. Codeline grants access to that organization's configured servers; it does not provision users.
OIDC_ORGANIZATION_ID=replace-with-codeline-organization-external-id
# A legacy single-provider configuration may use this provider-side alias as both provider and local ID. When the
# local ID above is configured, the legacy provider-side ID may differ.
# ZITADEL_ORGANIZATION_ID=replace-with-zitadel-resource-owner-id
# In OIDC mode, point deterministic example sessions and membership at the configured SSO identity. Seed and
# E2E commands choose a Zitadel issuer first, then Authworks, then provider-neutral OIDC for deterministic use.
# EXAMPLE_DATA_USER_ID=oidc:<sha256-of-selected-issuer-null-byte-EXAMPLE_DATA_SUBJECT>
# EXAMPLE_DATA_SUBJECT=replace-with-oidc-subject

# Provider credentials for the seeded catalog agents. Keep literal values only in the ignored project .env.
# CODEX_LB_API_TOKEN=
# CLIPROXYAPI_API_KEY=
# SUBS_CONTENTOREN_DE_API_KEY=
