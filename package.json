{
  "name": "@adaptive-ds/codeline",
  "version": "0.1.0",
  "description": "An AI coding workspace built for the fastest possible UI/UX with Zero's immediate, incrementally updated queries.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "homepage": "http://codeline.work/",
  "bugs": {
    "url": "https://github.com/david1gp/codeline/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david1gp/codeline.git"
  },
  "keywords": [
    "ai",
    "ai-native",
    "coding-assistant",
    "coding-workspace",
    "developer-tools",
    "realtime",
    "tanstack-ai",
    "solidjs",
    "hono",
    "zero",
    "postgresql",
    "typescript",
    "bun",
    "adaptive-ds"
  ],
  "scripts": {
    "dev": "bun run --parallel dev:api dev:ui",
    "dev:api": "bun run --watch src/index.ts",
    "dev:ui": "vite",
    "test": "bun test ./src ./test",
    "test:e2e": "playwright test",
    "typecheck": "bun tsc -p tsconfig.json --noEmit",
    "build": "rm -rf ./dist && bun tsc -p ./tsconfig.json && env -u VITE_USER_NODE_ENV -u VITE_ZERO_CACHE_URL -u VITE_ZERO_QUERY_URL -u VITE_ZERO_MUTATE_URL NODE_ENV=production vite build --mode production && bun build ./src/ui/pwa/serviceWorkerMain.ts --outfile ./dist/ui/service-worker.js --target browser --format iife --minify && bun build ./src/index.ts --outdir ./dist/server --target bun --sourcemap=external --external valibot",
    "release": "bash ./ops/release.sh",
    "release:inputs:verify": "bun scripts/releaseInputsVerify.ts",
    "git-store:link": "bash ./ops/dev/git-store-link.sh setup",
    "git-store:verify": "bash ./ops/dev/git-store-link.sh verify",
    "convex:codegen": "convex codegen",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:reset": "bun scripts/convexSeed.ts --reset-only",
    "convex:reset-seed": "bun scripts/convexSeed.ts --reset",
    "convex:seed": "bun scripts/convexSeed.ts",
    "convex:typecheck": "bun tsc -p convex/tsconfig.json --noEmit",
    "zero:update": "bun scripts/zeroHeadUpdate.ts",
    "zero:link": "bash ./ops/dev/zero-link.sh setup",
    "zero:verify": "bash ./ops/dev/zero-link.sh verify",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:seed": "bun run db:migrate && bun scripts/dbSeed.ts",
    "db:reset": "bun scripts/dbReset.ts",
    "db:reset-seed": "bun run db:reset && bun run db:migrate && bun scripts/dbSeed.ts --reset",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "format": "biome format --write convex src test e2e scripts ui index.html vite.config.ts playwright.config.ts package.json release-inputs.json tsconfig.json tsconfig.build.json biome.json bunfig.toml drizzle.config.ts",
    "format:check": "biome format convex src test e2e scripts ui index.html vite.config.ts playwright.config.ts package.json release-inputs.json tsconfig.json tsconfig.build.json biome.json bunfig.toml drizzle.config.ts",
    "ui": "rsync -avh --delete ../solid-ui/ui/ ./ui/",
    "ui:push": "rsync -avh --delete ./ui/ ../solid-ui/ui/"
  },
  "imports": {
    "#convex/*": "./convex/*",
    "#ui/*": "./ui/*",
    "#utils/*": "@adaptive-ds/utils/*"
  },
  "dependencies": {
    "@adaptive-ds/git-store": "link:@adaptive-ds/git-store",
    "@adaptive-ds/result": "^0.6.0",
    "@adaptive-ds/solid-ui": "^0.18.0",
    "@corvu/popover": "^0.2.0",
    "@mdi/js": "^7.4.47",
    "@rocicorp/zero": "1.10.0-head-9f1e077b-20260821",
    "@solidjs/router": "^1.0.0",
    "@tanstack/ai": "^0.44.0",
    "@tanstack/ai-client": "^0.23.2",
    "@tanstack/ai-openai": "0.19.0",
    "@tanstack/ai-solid": "^0.16.2",
    "@tanstack/ai-solid-ui": "^0.7.15",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "drizzle-orm": "0.45.2",
    "hono": "^4.12.8",
    "micromark": "^4.0.2",
    "oauth4webapi": "^3.8.7",
    "postgres": "3.4.9",
    "solid-js": "^1.9.12",
    "tailwind-merge": "^3.6.0",
    "valibot": "^1.3.1",
    "yaml": "^2.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14"
  },
  "author": {
    "name": "David Siewert",
    "url": "https://david-siewert.com/"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/david1gp"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
