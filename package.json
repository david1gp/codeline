{
  "name": "@adaptive-ds/codeline",
  "version": "0.1.0",
  "description": "A planned local-first AI coding workspace built with Solid, Hono, TanStack AI, and Zero.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/david1gp/codeline",
  "bugs": {
    "url": "https://github.com/david1gp/codeline/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david1gp/codeline.git"
  },
  "keywords": [
    "ai",
    "ai-native",
    "coding-assistant",
    "developer-tools",
    "tanstack-ai",
    "solidjs",
    "hono",
    "zero",
    "local-first",
    "typescript",
    "bun"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "test": "bun test",
    "build": "rm -rf ./dist && bun tsc -p ./tsconfig.build.json",
    "release": "bash ./ops/release.sh",
    "format": "biome format --write src test package.json tsconfig.json tsconfig.build.json biome.json bunfig.toml",
    "format:check": "biome format src test package.json tsconfig.json tsconfig.build.json biome.json bunfig.toml"
  },
  "dependencies": {
    "@adaptive-ds/solid-ui": "^0.18.0",
    "@tanstack/ai": "^0.44.0",
    "@tanstack/ai-client": "^0.23.2",
    "@tanstack/ai-solid": "^0.16.2",
    "@tanstack/ai-solid-ui": "^0.7.15",
    "hono": "^4.12.8",
    "solid-js": "^1.9.12",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
