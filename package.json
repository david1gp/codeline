{
  "name": "@adaptive-ds/codeline",
  "version": "0.1.0",
  "description": "An AI coding workspace built for the fastest possible UI/UX with Zero's immediate, incrementally updated queries.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "homepage": "http://codeline.work/",
  "bugs": {
    "url": "https://github.com/david1gp/codeline/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david1gp/codeline.git"
  },
  "keywords": [
    "ai",
    "ai-native",
    "coding-assistant",
    "coding-workspace",
    "developer-tools",
    "realtime",
    "tanstack-ai",
    "solidjs",
    "hono",
    "zero",
    "postgresql",
    "typescript",
    "bun",
    "adaptive-ds"
  ],
  "scripts": {
    "dev": "bun run --parallel dev:api dev:ui",
    "dev:api": "bun run --watch src/index.ts",
    "dev:ui": "vite",
    "test": "bun test",
    "typecheck": "bun tsc -p tsconfig.json --noEmit",
    "build": "rm -rf ./dist && bun tsc -p ./tsconfig.json && vite build && bun build ./src/index.ts --outdir ./dist/server --target bun --sourcemap=external",
    "release": "bash ./ops/release.sh",
    "zero:link": "bash ./ops/dev/zero-link.sh setup",
    "zero:verify": "bash ./ops/dev/zero-link.sh verify",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:seed": "drizzle-kit migrate --config drizzle.config.ts && bun scripts/dbSeed.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "format": "biome format --write src test scripts index.html vite.config.ts package.json tsconfig.json tsconfig.build.json biome.json bunfig.toml drizzle.config.ts",
    "format:check": "biome format src test scripts index.html vite.config.ts package.json tsconfig.json tsconfig.build.json biome.json bunfig.toml drizzle.config.ts"
  },
  "dependencies": {
    "@adaptive-ds/result": "^0.6.0",
    "@adaptive-ds/solid-ui": "^0.18.0",
    "@rocicorp/zero": "link:@rocicorp/zero",
    "@solidjs/router": "^1.0.0",
    "@tanstack/ai": "^0.44.0",
    "@tanstack/ai-client": "^0.23.2",
    "@tanstack/ai-solid": "^0.16.2",
    "@tanstack/ai-solid-ui": "^0.7.15",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "hono": "^4.12.8",
    "micromark": "^4.0.2",
    "postgres": "3.4.9",
    "solid-js": "^1.9.12",
    "tailwind-merge": "^3.6.0",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14"
  },
  "author": {
    "name": "David Siewert",
    "url": "https://david-siewert.com/"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/david1gp"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
