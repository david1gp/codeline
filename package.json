{
  "name": "@adaptive-ds/codeline",
  "version": "0.1.0",
  "description": "An AI coding workspace with a SQLite-backed typed HTTP and SSE data layer for fast, durable UI/UX.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "homepage": "http://codeline.work/",
  "bugs": {
    "url": "https://github.com/david1gp/codeline/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david1gp/codeline.git"
  },
  "keywords": [
    "ai",
    "ai-native",
    "coding-assistant",
    "coding-workspace",
    "developer-tools",
    "realtime",
    "sqlite",
    "http",
    "sse",
    "typed-http",
    "tanstack-ai",
    "solidjs",
    "hono",
    "typescript",
    "bun",
    "adaptive-ds"
  ],
  "scripts": {
    "dev": "bun run --parallel dev:api dev:ui",
    "dev:api": "bun run --watch src/index.ts",
    "dev:ui": "vite",
    "start": "bun run ./dist/server/index.js",
    "deploy": "bash ./ops/deploy.sh",
    "test": "bun test --max-concurrency=1 --dots --bail=1 --path-ignore-patterns='**/providerRuntimeChatIntegration.test.ts' ./src ./test",
    "test:integration": "bun test --max-concurrency=1 --dots --bail=1 ./test/providerRuntimeChatIntegration.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "bun tsc -p tsconfig.json --noEmit",
    "build": "build_dir=${CODELINE_BUILD_DIR:-./dist}; rm -rf -- \"$build_dir\" && bun tsc -p ./tsconfig.json && env -u VITE_USER_NODE_ENV NODE_ENV=production vite build --mode production --outDir \"$build_dir/ui\" && bun build ./src/ui/pwa/serviceWorkerMain.ts --outfile \"$build_dir/ui/service-worker.js\" --target browser --format iife --minify && bun build ./src/index.ts --outdir \"$build_dir/server\" --target bun --sourcemap=external --external valibot",
    "release": "bash ./ops/release.sh",
    "release:inputs:verify": "bun scripts/releaseInputsVerify.ts",
    "git-store:link": "bash ./ops/dev/git-store-link.sh setup",
    "git-store:verify": "bash ./ops/dev/git-store-link.sh verify",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "bun scripts/dbMigrate.ts",
    "db:seed": "bun scripts/managedDatabaseResetLockRun.ts -- sh -c 'bun run db:migrate && bun scripts/dbSeed.ts \"$@\"' --",
    "db:reset": "bun scripts/dbReset.ts",
    "db:reset-seed": "bun scripts/managedDatabaseResetLockRun.ts -- sh -c 'bun scripts/dbReset.ts && bun run db:migrate && bun scripts/dbSeed.ts --reset'",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "format": "biome format --write src test e2e scripts ui index.html vite.config.ts playwright.config.ts package.json release-inputs.json tsconfig.json tsconfig.build.json biome.json bunfig.toml drizzle.config.ts",
    "format:check": "biome format src test e2e scripts ui index.html vite.config.ts playwright.config.ts package.json release-inputs.json tsconfig.json tsconfig.build.json biome.json bunfig.toml drizzle.config.ts",
    "ui": "rsync -avh --delete ../solid-ui/ui/ ./ui/",
    "ui:push": "rsync -avh --delete ./ui/ ../solid-ui/ui/"
  },
  "imports": {
    "#ui/*": "./ui/*",
    "#utils/*": "@adaptive-ds/utils/*"
  },
  "dependencies": {
    "@adaptive-ds/git-store": "link:@adaptive-ds/git-store",
    "@adaptive-ds/mdi": "^0.1.2",
    "@adaptive-ds/result": "^0.6.0",
    "@adaptive-ds/solid-ui": "^0.19.1",
    "@corvu/popover": "^0.2.0",
    "@libsql/client": "^0.17.3",
    "@solidjs/router": "^1.0.0",
    "@tanstack/ai": "0.45.1",
    "@tanstack/ai-client": "0.23.2",
    "@tanstack/ai-openai": "0.19.0",
    "@tanstack/ai-solid": "0.16.2",
    "@tanstack/ai-solid-ui": "^0.7.15",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "hono": "^4.12.8",
    "idb": "^8.0.3",
    "micromark": "^4.0.2",
    "oauth4webapi": "^3.8.7",
    "solid-js": "^1.9.12",
    "tailwind-merge": "^3.6.0",
    "valibot": "^1.3.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "drizzle-kit": "0.31.10",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14"
  },
  "overrides": {
    "@tanstack/openai-base": "0.9.14"
  },
  "author": {
    "name": "David Siewert",
    "url": "https://david-siewert.com/"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/david1gp"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
