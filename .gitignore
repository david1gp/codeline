# Dependencies
node_modules/

# Bun package manager
bun.lock
bun.lockb

# Build output
dist/
out/
build/
*.tgz
ops/dev/zero-pkgs/

# Tests and logs
coverage/
test-results/
playwright-report/
*.lcov
logs/
*.log

# Local operating-system and editor files
.DS_Store
.idea/
.vscode/
*.iml

# Dotenv secrets. Keep the distributable template tracked.
.env
.env.*
!.env.example
!.env.production

# Application icons must stay tracked even when a global ignore excludes images.
!public/icons/*.png

# Local application data and caches
data/
.cache/
.turbo/
*.tsbuildinfo
.wrangler/

# Convex generated API, server, and data-model types. Regenerate with bun run convex:codegen.
convex/_generated/

# Self-hosted Convex container credentials.
ops/dev/convex/.env.docker
