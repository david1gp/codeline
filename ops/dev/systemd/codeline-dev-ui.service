[Unit]
Description=Codeline development UI
After=codeline-dev-api.service
Requires=codeline-dev-api.service
PartOf=codeline-dev.target

[Service]
Type=simple
WorkingDirectory=%h/codeline
EnvironmentFile=%h/codeline/.env
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env bun run dev:ui -- --host 127.0.0.1
ExecStartPost=%h/codeline/ops/dev/codeline-dev.sh wait ui
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
