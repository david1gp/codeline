[Unit]
Description=Codeline development API
Requires=codeline-dev-postgres.service
After=codeline-dev-postgres.service codeline-dev-zero-cache.service
PartOf=codeline-dev.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
EnvironmentFile=@ROOT@/.env
ExecStart=@BUN@ run dev:api
ExecStartPost=@ROOT@/ops/dev/codeline-dev.sh wait api
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s

[Install]
WantedBy=codeline-dev.target
