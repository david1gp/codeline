[Unit]
Description=Codeline development UI
Requires=codeline-dev-api.service
After=codeline-dev-api.service
PartOf=codeline-dev.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
EnvironmentFile=@ROOT@/.env
ExecStart=@NODE@ @ROOT@/node_modules/vite/bin/vite.js --host 127.0.0.1
ExecStartPost=@ROOT@/ops/dev/codeline-dev.sh wait ui
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s

[Install]
WantedBy=codeline-dev.target
