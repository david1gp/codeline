[Unit]
Description=Codeline combined preview service
After=network-online.target
Wants=network-online.target
PartOf=codeline-dev.target

[Service]
Type=simple
WorkingDirectory=%h/adaptive/codeline
EnvironmentFile=-%h/adaptive/codeline/ops/dev/codeline-defaults.env
EnvironmentFile=%h/adaptive/codeline/.env
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env bun ./dist/server/index.js
ExecStartPost=%h/adaptive/codeline/ops/dev/codeline-dev.sh wait api
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
