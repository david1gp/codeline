# Self-hosted Convex dashboard for the Codeline development deployment.
# Quadlet generates codeline-convex-dashboard.service from this file.
[Unit]
Description=Codeline self-hosted Convex dashboard (Podman Quadlet)
After=codeline-convex-backend.service
Requires=codeline-convex-backend.service

[Container]
ContainerName=codeline-convex-dashboard
Image=ghcr.io/get-convex/convex-dashboard:latest
AutoUpdate=registry
Network=host
EnvironmentFile=%h/codeline/ops/dev/convex/.env.docker
Notify=healthy
HealthCmd=curl -f http://127.0.0.1:6791/
HealthInterval=5s
HealthStartPeriod=10s

[Service]
Restart=always
RestartSec=2s

[Install]
WantedBy=default.target
