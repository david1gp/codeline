# Template for ops/dev/convex/.env.docker (gitignored). This is the container
# environment for the one self-hosted Codeline Convex deployment on this host.
#
# Copy this file and replace every placeholder before installing the managed
# units. The browser and CLI environment stays in the repository .env file.

CONVEX_CLOUD_ORIGIN=https://convex.preview.codeline.work
CONVEX_SITE_ORIGIN=https://api.preview.codeline.work
NEXT_PUBLIC_DEPLOYMENT_URL=https://convex.preview.codeline.work

INSTANCE_NAME=codeline-development
INSTANCE_SECRET=replace-with-64-lowercase-hex-characters
DISABLE_BEACON=true
